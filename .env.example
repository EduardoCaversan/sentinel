APP_NAME=Sentinel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
LOG_CHANNEL=stderr
LOG_LEVEL=info
BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=sentinel
DB_USERNAME=sentinel
# Local development only. Set unique secrets for deployment.
DB_PASSWORD=sentinel-local
DB_ROOT_PASSWORD=sentinel-root-local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=120
CACHE_STORE=redis
SESSION_DRIVER=array

REGISTRATION_ENABLED=true
# Organization quotas and bounded history. Existing checks are pruned hourly.
RETENTION_DAYS=30
MAX_RETENTION_DAYS=90
MIN_CHECK_INTERVAL_SECONDS=60
RESPONSE_MAX_BYTES=1048576
QUOTA_ORGANIZATIONS=5
QUOTA_MONITORS=50
QUOTA_MEMBERS=25
QUOTA_API_KEYS=20
QUOTA_NOTIFICATION_CHANNELS=10
QUOTA_STATUS_PAGES=5
QUOTA_MAINTENANCE_WINDOWS=50
# Opt-in, never seeded with a hard-coded password.
DEMO_SEED=false
DEMO_EMAIL=
DEMO_PASSWORD=
