            }
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "security": []
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Check readiness",
        "operationId": "operationsCheckreadiness",
        "tags": [
          "Operations"
        ],
        "description": "MariaDB and Redis connectivity. Queue backlog and scheduler activity must be monitored separately.",
        "responses": {
          "200": {
            "description": "Success",
