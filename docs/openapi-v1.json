    "/api/v1/auth/register": {
      "post": {
        "summary": "Register",
        "operationId": "authenticationRegister",
        "tags": [
          "Authentication"
        ],
        "description": "10 auth requests/minute per IP, combined with login. Passwords require at least 12 characters, a letter and a number; max 72 characters. Tokens expire in seven days. Registration can be disabled for a demo.",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Auth"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 255
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 12,
                    "maxLength": 72
                  },
                  "password_confirmation": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": [
                  "name",
                  "email",
                  "password",
                  "password_confirmation"
                ]
              },
              "example": {
                "name": "Ada",
                "email": "ada@example.com",
                "password": "ChooseYourOwn123!",
                "password_confirmation": "ChooseYourOwn123!"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login",
        "operationId": "authenticationLogin",
        "tags": [
          "Authentication"
        ],
        "description": "Returns a new seven-day Bearer token. 10 auth requests/minute per IP.",
        "responses": {
          "200": {
            "description": "Success",
