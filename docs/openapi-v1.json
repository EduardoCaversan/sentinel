    "/api/v1/monitors": {
      "get": {
        "summary": "List monitors",
        "operationId": "monitorsListmonitors",
        "tags": [
          "Monitors"
        ],
        "description": "",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorPage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Page number."
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Results per page, newest ID first."
          }
        ]
      },
      "post": {
        "summary": "Create monitor",
        "operationId": "monitorsCreatemonitor",
        "tags": [
          "Monitors"
        ],
        "description": "Creates a GET monitor with unknown health. The scheduler discovers it on its next minute tick. Only validated fields are accepted; ownership and health are controlled by the server.",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Monitor"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MonitorInput"
              }
            }
          }
        }
      }
    },
    "/api/v1/monitors/{monitor}": {
      "get": {
        "summary": "Get monitor",
        "operationId": "monitorsGetmonitor",
        "tags": [
          "Monitors"
        ],
        "description": "",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Monitor"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "parameters": [
          {
            "name": "monitor",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "ID of a monitor owned by the authenticated user. Other owners receive 404."
          }
        ]
      },
      "patch": {
        "summary": "Update monitor",
        "operationId": "monitorsUpdatemonitor",
        "tags": [
          "Monitors"
        ],
        "description": "Fields are optional. Any actual edit resets consecutive counters and discards in-flight results from earlier settings. Existing incidents stay open until recovery. Pausing does not resolve an incident.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Monitor"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "parameters": [
          {
            "name": "monitor",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "ID of a monitor owned by the authenticated user. Other owners receive 404."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MonitorPatch"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete monitor",
        "operationId": "monitorsDeletemonitor",
        "tags": [
          "Monitors"
        ],
        "description": "Permanently deletes this monitor, its checks and incidents. Queued jobs become no-ops.",
        "responses": {
          "204": {
            "description": "Deleted or token revoked"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "parameters": [
          {
            "name": "monitor",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "ID of a monitor owned by the authenticated user. Other owners receive 404."
          }
        ]
      }
    },
    "/api/v1/monitors/{monitor}/checks": {
      "get": {
        "summary": "List checks",
        "operationId": "monitoringListchecks",
        "tags": [
          "Monitoring"
        ],
        "description": "Newest recorded checks first. Response bodies and raw network errors are never stored.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckPage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "parameters": [
          {
            "name": "monitor",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "ID of a monitor owned by the authenticated user. Other owners receive 404."
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Page number."
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Results per page, newest ID first."
          }
        ]
      }
    },
    "/api/v1/monitors/{monitor}/incidents": {
      "get": {
        "summary": "List incidents",
        "operationId": "monitoringListincidents",
        "tags": [
          "Monitoring"
        ],
        "description": "Newest incidents first. failure_count includes the opening failure streak and later failures; recovery_count is the current consecutive recovery streak.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentPage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "parameters": [
          {
            "name": "monitor",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "ID of a monitor owned by the authenticated user. Other owners receive 404."
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Page number."
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Results per page, newest ID first."
          }
        ]
      }
    },
    "/api/v1/monitors/{monitor}/check": {
      "post": {
        "summary": "Request check",
        "operationId": "monitoringRequestcheck",
        "tags": [
          "Monitoring"
        ],
        "description": "Asynchronous; poll checks for the result. Repeated requests coalesce while a job is pending or running (unique lease: 120 seconds). Limited to six requests/minute per user. A 202 does not mean the endpoint is healthy.",
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "monitor_id": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "message": {
                          "type": "string",
                          "example": "Check requested. An existing queued or running check may satisfy this request."
                        }
                      },
                      "required": [
                        "monitor_id",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "parameters": [
          {
            "name": "monitor",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "ID of a monitor owned by the authenticated user. Other owners receive 404."
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum token"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": false
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "created_at"
        ]
      },
      "Auth": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "token": {
            "type": "string",
            "description": "Shown only once. Paste into Authorize without the Bearer prefix."
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "nullable": false
          }
        },
        "required": [
          "user",
          "token",
          "token_type",
          "expires_at"
        ]
      },
      "MonitorInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Payment API"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "example": "https://example.com",
            "description": "Public HTTP:80 or HTTPS:443. No credentials, fragment, redirects, private or reserved addresses. Every DNS address must be public. DNS is checked when saving and executing."
          },
          "method": {
            "type": "string",
            "enum": [
              "GET"
            ],
            "default": "GET"
          },
          "expected_status_code": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599,
            "default": 200
          },
          "interval_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400,
            "multipleOf": 60,
            "default": 60,
            "description": "Minute resolution; dispatch can be up to one minute later, plus queue delay."
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15,
            "default": 5
