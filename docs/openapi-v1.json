{
  "openapi": "3.0.3",
  "info": {
    "title": "Sentinel API",
    "version": "1.0.0",
    "description": "HTTP monitoring and automatic incident management.\n\nStart with register or login. Copy data.token, click Authorize, and paste the token. Create a monitor, request a check, then inspect check history and incidents. All monitor routes are scoped to the authenticated owner.\n\nSuccess responses use data; paginated responses add links and meta. Errors use message and validation failures add errors. Default limit: 120 requests/minute per user (or IP for guests). Health checks are GET only; redirects are never followed.\n\nHealth: unknown → healthy on success; failure → degraded; failure threshold → down and one open incident; recovery threshold → healthy and incident resolved.",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Sentinel server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Authentication"
    },
    {
      "name": "Monitors"
    },
    {
      "name": "Monitoring"
    },
    {
      "name": "Operations"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "API information",
        "operationId": "operationsAPIinformation",
        "tags": [
          "Operations"
        ],
        "description": "Liveness information and discovery links. Use readiness to verify dependencies.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Root"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "security": []
      }
    },
